<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA">

    <!-- Main Content -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_header_gradient"
                android:padding="24dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="dGoal"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Let's achieve your goals."
                        android:textColor="#E5DFFC"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/settingsButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_circle_purple"
                    android:gravity="center"
                    android:text="⚙"
                    android:textColor="#6C4CE0"
                    android:textSize="20sp" />

            </LinearLayout>

            <!-- Progress Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Today's Progress"
                android:textColor="#17191C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Progress Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_rounded"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/progressPercentage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0%"
                    android:textColor="#6C4CE0"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/todayProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="16dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_bar_rounded" />

                <TextView
                    android:id="@+id/taskCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="0 of 0 tasks completed"
                    android:textColor="#777B82"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Today's Tasks -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Today's Tasks"
                android:textColor="#17191C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Empty Task Card -->
            <LinearLayout
                android:id="@+id/taskContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:gravity="center"
                android:minHeight="100dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/noTasksText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No tasks yet"
                    android:textColor="#777B82"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Tap + to add your first task"
                    android:textColor="#A0A4AA"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Add Task Button -->
            <Button
                android:id="@+id/addTaskButton"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="14dp"
                android:text="+  Add Task"
                android:textSize="16sp" />

            <!-- Monthly Goal -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Monthly Goal"
                android:textColor="#17191C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/monthlyGoalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No monthly goal set"
                    android:textColor="#17191C"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/monthlyGoalProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Set a goal and start making progress."
                    android:textColor="#777B82"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/setGoalButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:text="Set Monthly Goal" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Goals Screen (Monthly Goals) -->
    <ScrollView
        android:id="@+id/goalsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monthly Goals"
                android:textColor="#17191C"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="See how each task is tracking this month."
                android:textColor="#777B82"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/goalsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⌂&#10;Home"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tasksButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="✓&#10;Tasks"
            android:textSize="12sp" />

        <Button
            android:id="@+id/goalsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="★&#10;Goals"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>